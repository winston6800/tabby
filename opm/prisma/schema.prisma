// Prisma schema for OPM project

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  discord_id String?  @unique
  created_at DateTime @default(now())
  profile    Profile?

  @@map("users")
}

model Profile {
  user_id     Int     @id
  user        User    @relation(fields: [user_id], references: [id])
  display_name String
  avatar_url  String?
  bio         String?

  @@map("profiles")
}
